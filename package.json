{
  "name": "ops-genie",
  "version": "0.1.0",
  "description": "A TypeScript CLI that manages an ops workspace and delegates prompts to Claude",
  "main": "dist/index.js",
  "bin": {
    "ops-genie": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
